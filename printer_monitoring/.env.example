# Azure Custom Vision Settings
VISION_PREDICTION_KEY=your-prediction-key-here
VISION_PROJECT_ID=your-project-id-here
VISION_ITERATION_NAME=Iteration3
VISION_API_ENDPOINT=https://your-endpoint.cognitiveservices.azure.com/customvision/v3.0/Prediction

# URL Settings
MOONRAKER_BASE_URL=http://your-printer-url:3002
WEBCAM_URL=http://your-printer-url:3002/webcam/

# Network Settings
REQUEST_TIMEOUT=5
MAX_RETRIES=3
RETRY_DELAY=1

# Monitoring Settings
DETECTION_THRESHOLD=0.7
FRAME_INTERVAL=1.0
PROCESSING_THRESHOLD=0.5
FRAME_SKIP=2

# Image Processing Settings
JPEG_QUALITY=95
MIN_IMAGE_WIDTH=640
MIN_IMAGE_HEIGHT=480
MAX_IMAGE_WIDTH=1920
MAX_IMAGE_HEIGHT=1080